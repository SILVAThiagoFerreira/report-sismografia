{
  "system": {
    "name": "Report Sismografia OpenBlast",
    "version": "1.0.0"
  },
  "paths": {
    "input_dir": "input",
    "output_dir": "output",
    "logs_dir": "logs",
    "legacy_input_dir": "INPUTS",
    "legacy_output_dir": "OUTPUTS",
    "logo_path": "ICONE/openblast-logo.png"
  },
  "execution": {
    "watch_interval_seconds": 5,
    "file_glob": "*.pdf",
    "default_command": "generate"
  },
  "report": {
    "summary_record_limit": 3,
    "png_scale": 6.0,
    "png_page_number": 0,
    "vibration_alert_threshold_mm_s": 0.8
  },
  "charts": {
    "figure_width": 9.0,
    "figure_height": 7.0,
    "web_figure_width": 6.5,
    "figure_dpi": 220
  },
  "report_layout": {
    "first_page_last_card_y": 45.0,
    "point_card_gap": 8.0,
    "points_title_gap": 12.0,
    "chart_to_points_gap": 8.0
  }
}
